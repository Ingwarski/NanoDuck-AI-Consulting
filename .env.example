# Production values belong in the deployment secret store, never in Git.
NODE_ENV=production
APP_ORIGIN=https://consulting.example.com
PORT=3000
DATABASE_URL=mysql://user:password@host:3306/nanoduck
DATABASE_SSL_CA_PATH=/run/secrets/nanoduck-mysql-ca.pem
DATA_ENCRYPTION_KEY=base64url-encoded-32-byte-key
SESSION_SIGNING_KEY=base64url-encoded-32-byte-key
OWNER_GOOGLE_SUBJECT=google-subject-id
GOOGLE_CLIENT_ID=google-oauth-client-id
GOOGLE_CLIENT_SECRET=google-oauth-client-secret
CODEX_APP_SERVER_AUTH_PATH=/run/secrets/codex-auth.json
SESSION_ABSOLUTE_SECONDS=86400
MAX_ATTACHMENT_BYTES=8388608
MAX_AUDIO_SECONDS=300
