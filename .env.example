# Production values belong in the deployment secret store, never in Git.
NODE_ENV=production
APP_ORIGIN=https://consulting.example.com
PORT=3000
# Use DATABASE_URL on hosts that expose a full URI, or GoDaddy's injected DB_* values.
DATABASE_URL=mysql://user:password@host:3306/nanoduck
DB_HOST=godaddy-managed-host
DB_PORT=3306
DB_NAME=godaddy-managed-database
DB_USER=godaddy-managed-user
DB_PASSWORD=godaddy-managed-password
# Optional private CA file for hosts that require a custom trust root. TLS verification stays enabled either way.
DATABASE_SSL_CA_PATH=/run/secrets/nanoduck-mysql-ca.pem
DATA_ENCRYPTION_KEY=base64url-encoded-32-byte-key
# Required only for the first `npm run migrate` on an empty NanoDuck database.
# Base64url-encoded UTF-8 Markdown; remove it from the secret store after bootstrap.
RUNTIME_INSTRUCTIONS_BOOTSTRAP_B64=base64url-encoded-runtime-instructions-markdown
RECOVERY_ENCRYPTION_KEY=different-base64url-encoded-32-byte-key
SESSION_SIGNING_KEY=base64url-encoded-32-byte-key
# Pin the verified Google account by stable subject where available; the existing GoDaddy app supplies its verified email.
OWNER_GOOGLE_SUBJECT=google-subject-id
OWNER_GOOGLE_EMAIL=owner@example.com
GOOGLE_CLIENT_ID=google-oauth-client-id
GOOGLE_CLIENT_SECRET=google-oauth-client-secret
# Use a mounted file where the host supports it, otherwise provide the same auth.json bytes as base64url.
CODEX_APP_SERVER_AUTH_PATH=/run/secrets/codex-auth.json
CODEX_APP_SERVER_AUTH_B64=base64url-encoded-codex-auth-json
SESSION_ABSOLUTE_SECONDS=86400
MAX_ATTACHMENT_BYTES=8388608
